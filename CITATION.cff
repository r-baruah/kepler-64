cff-version: 1.2.0
message: "If you use Kepler-64 in your research or benchmarks, please cite it as below."
authors:
  - family-names: Baruah
    given-names: Ripuranjan
    name: "Ripuranjan Baruah"
title: "Kepler-64: an experiment in playing chess using four 2D physics equations and ten numbers"
abstract: "An experiment in playing chess using newly derived physics formulas built for a 2D board: pieces carry weight, pull travels along legal move lines, spreads thin over the squares it reaches, and stops at a speed limit of two moves. Ten active constants (40 bytes) control the evaluation, and every law is tested by ablation in a public Law Ledger."
url: "https://github.com/r-baruah/kepler-64"
repository-code: "https://github.com/r-baruah/kepler-64"
license: "MIT"
keywords:
  - "physics"
  - "chess"
  - "experiment"
  - "simulation"
  - "rust"
  - "webassembly"
  - "ablation"
