cff-version: 1.2.0
message: "If you use Kepler-64 in your research or benchmarks, please cite it as below."
authors:
  - family-names: Baruah
    given-names: Ripuranjan
    name: "Ripuranjan Baruah"
title: "Kepler-64: a chess engine whose evaluation is a physics-style field learned by self-play"
abstract: "A chess engine whose only evaluation is a field shaped by the rules of chess: pull travels along the lines pieces can legally move and stops at the first piece in the way. About a dozen constants (piece masses, a light speed in moves, and the weight of each law) are learned by self-play, and every law must pass an ablation test to stay in the evaluation."
url: "https://github.com/r-baruah/kepler-64"
repository-code: "https://github.com/r-baruah/kepler-64"
license: "MIT"
keywords:
  - "chess engine"
  - "self-play"
  - "interpretable evaluation"
  - "physics-inspired evaluation"
  - "ablation"
  - "rust"
  - "webassembly"
