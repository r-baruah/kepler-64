# Generated game files (PGN output from play_vs_sf.py etc.)
/games_*.pgn

# Trained constants: produced by scripts/train.py or the GitHub training
# workflow. The workflow commits the *real* trained artifact back to the repo,
# so we do NOT ignore it (unlike other generated files). A local degenerate
# run would be overwritten by the next workflow run.
# kepler64/training/trained_constants.json
